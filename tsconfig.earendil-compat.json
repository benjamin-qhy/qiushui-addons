{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "addons/customer-support-demo/**/*.ts",
    "addons/customer-support-demo/**/*.tsx",
    "addons/observability/**/*.tsx",
    "addons/export-timeline-pdf/**/*.ts",
    "addons/observability/**/*.ts",
    "addons/sample-addon/**/*.ts",
    "addons/sample-addon/**/*.tsx",
    "addons/settings-dialog-screenshot/**/*.ts",
    "addons/vent/**/*.ts",
    "addons/vent/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "addons/**/tests/**",
    "addons/**/*.test.ts"
  ]
}
